# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Public URL of the site. Used for canonical URLs, Open Graph images,
# the sitemap and JSON-LD. No trailing slash. Optional on Vercel, where it
# defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL=https://creedtech.com.ng

# Resend API key (https://resend.com/api-keys). Required in production for
# the contact form. In development, submissions are logged to the terminal
# when this is not set.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=creedit.2024@gmail.com

# Optional. Sender address for contact form emails. Must be on a domain you
# have verified in Resend. Defaults to Resend's shared test sender.
CONTACT_FROM_EMAIL="Creedtech Website <onboarding@resend.dev>"
